rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper authorization functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Enforce first-login 6-digit OTP verification from carromlotterydesk@gmail.com.
    // Verified status can ONLY be set by the server (Google Apps Script Service Account or Cloud Functions)
    // via custom token claim `otpVerified == true` or server-only `/users/{uid}` fields.
    function isOtpVerified() {
      return isAuthenticated() && (
        request.auth.token.otpVerified == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.otpVerified == true &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.firstLoginCompleted == true
        )
      );
    }
    
    // Resolve role: checks server-signed custom claims first, falls back to server-managed /users/{uid}, defaults to 'employee'
    function getUserRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            : 'employee');
    }
    
    function isAdmin() {
      return isOtpVerified() && getUserRole() == 'admin';
    }
    
    function isPaidEmployeeRole() {
      return isOtpVerified() && getUserRole() == 'paid_employee';
    }
    
    function isRegularEmployeeRole() {
      return isOtpVerified() && getUserRole() == 'employee';
    }
    
    function isEmployee() {
      return isOtpVerified() && (getUserRole() == 'employee' || getUserRole() == 'admin');
    }

    // 0A. Server-Only OTP Challenges (Never readable or writable by clients)
    match /otpChallenges/{userId} {
      allow read, write: if false;
    }

    // 0B. Server-Only Username Directory (Prevents public username-to-email enumeration)
    match /userDirectory/{username} {
      allow read, write: if false;
    }

    // 0C. Server-Only Booking Idempotency Store (Prevents duplicate bookings/codes on network retry)
    match /bookingIdempotency/{idempotencyKey} {
      allow read, write: if false;
    }

    // 0D. Customer Serial Code Registry & Customer Identity Records:
    // - Readable by Admin ONLY (Requirement 1 & 3: Paid Employees and standard employees must NOT read or enumerate customers or codes)
    // - Writable ONLY by the trusted backend (Apps Script Service Account); clients can never
    //   create, alter, or impersonate customer serial codes (#XXXX).
    match /customerCodes/{codeDigits} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /customers/{customerKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 0E. Real-Time Ticket Locks (/ticketLocks/{drawDateKey}_{ticketNumber}):
    // - Readable by Admin and Regular Employees (shared ticket availability for grid booking).
    // - Requirement 4: Paid employees must NOT read or access /ticketLocks (cannot infer or access ticket grid).
    // - Writable ONLY by trusted backend so no client can forge, extend, or release another user's lock.
    match /ticketLocks/{lockDocId} {
      allow read: if isOtpVerified() && !isPaidEmployeeRole();
      allow write: if false;
    }

    // 0F. Persistent Employee Label & Identity Mapping (Admin Only)
    // - Requirements 2, 3 & 4: Only Admin can access the UID -> Real Name mapping (e.g. L1 — [real name]).
    // - Paid Employees and Regular Employees are strictly DENIED read/write access.
    // - Writable exclusively by trusted server backend.
    match /employeeLabels/{employeeUid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 1. System Configuration:
    // - /config/system: readable by verified staff for businessDate & seriesTitle header display.
    // - /config/appearance, /config/weeklyPresets, /config/employeeLabelRegistry: Admin only.
    match /config/{docId} {
      allow read: if isOtpVerified() && (docId == 'system' ? true : isAdmin());
      allow write: if isAdmin();
    }

    // 2. User Profiles & Role Records:
    // - Unverified users cannot read `/users/{userId}`.
    // - Verified non-admin users can `get` ONLY their own `/users/{uid}` document and cannot `list` other users.
    // - All client writes to `/users/{userId}` are blocked (`allow write: if false;`); user roles and
    //   `otpVerified` flags are managed exclusively by the server (Apps Script Service Account / Firebase Console).
    match /users/{userId} {
      allow get: if isOtpVerified() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // 3. Deterministic Ticket Reservations: /draws/{drawDate}/series/{seriesId}/tickets/{ticketNumber}
    // - Readable by Admin and Regular Employees (shared ticket availability for grid booking).
    // - Requirement 3: Paid employees must NOT read or enumerate /draws/.../tickets.
    match /draws/{drawDate}/series/{seriesId}/tickets/{ticketNumber} {
      allow read: if isOtpVerified() && !isPaidEmployeeRole();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // 3B. Admin-Controlled Ticket Inventory (/ticketInventory/{drawKey}_{seriesId}_{ticketNumber})
    // - Readable by Admin and Regular Employees (shared ticket availability for grid booking).
    // - Requirement 3: Paid employees must NOT read or enumerate /ticketInventory.
    match /ticketInventory/{inventoryId} {
      allow read: if isOtpVerified() && !isPaidEmployeeRole() && (isAdmin() || resource.data.status == 'PUBLISHED');
      allow write: if isAdmin();
    }

    // 4. Bookings Collection — Strict Role-Based Isolation
    // - Admin: can view all bookings (Requirement 1).
    // - Regular Employees: can read ONLY their own bookings (Requirement 2).
    // - Paid Employees: must NOT read or enumerate /bookings (Requirement 3).
    // - Client writes/updates blocked: Completed payment task updates and balance changes
    //   are committed exclusively through the trusted server backend (Apps Script / Admin SDK).
    match /bookings/{bookingId} {
      allow read: if isOtpVerified() && (
        isAdmin() ||
        (isRegularEmployeeRole() && resource.data.bookedByUid == request.auth.uid)
      );
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // 5. Append-Only Payments Collection
    // - Admin can view all payments (Requirement 1).
    // - Client direct writes blocked: payments are committed exclusively via trusted backend (Requirement 6).
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // 5B. Restricted Payment Queue Collection (Generated and maintained exclusively by trusted backend)
    // - Requirement 4: Paid employees can view ONLY a restricted payment queue containing the minimum
    //   necessary fields for pending or partially paid bookings requiring their action.
    // - Requirement 5: Generated & maintained by trusted backend; full booking documents never exposed.
    // - Direct client writes are blocked (Completed action is processed via validated server endpoint).
    match /paymentQueue/{taskId} {
      allow read: if isOtpVerified() && (isAdmin() || isPaidEmployeeRole());
      allow write: if false;
    }

    // 6. Append-Only Audit Trail Collection (Server/Console-read only; clients cannot read audit logs)
    match /auditEvents/{eventId} {
      allow read: if false;
      allow create: if isEmployee()
        && request.resource.data.action == 'BOOKING_BATCH_CREATED'
        && request.resource.data.ticketCount is int
        && request.resource.data.ticketCount > 0;
      allow update, delete: if false;
    }

    // 7. Today Winner Records
    match /winners/{winnerId} {
      allow read: if isOtpVerified();
      allow write: if isAdmin();
    }

    // 8. Result Papers
    match /resultPapers/{paperId} {
      allow read: if isOtpVerified();
      allow write: if isAdmin();
    }
  }
}
