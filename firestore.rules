rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // AUTHORIZATION HELPERS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Resolves role with strict zero-trust fallback ('none' for unprofiled users)
    function getUserRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none')
            : 'none');
    }

    // Enforces first-login 6-digit OTP verification
    function isOtpVerified() {
      return isAuthenticated() && (
        request.auth.token.otpVerified == true ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('otpVerified', false) == true &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('firstLoginCompleted', false) == true
        )
      );
    }
    
    function isAdmin() {
      return isOtpVerified() && getUserRole() == 'admin';
    }
    
    function isPaidEmployeeRole() {
      return isOtpVerified() && getUserRole() == 'paid_employee';
    }
    
    function isRegularEmployeeRole() {
      return isOtpVerified() && getUserRole() == 'employee';
    }
    
    function isEmployee() {
      return isOtpVerified() && (getUserRole() == 'employee' || getUserRole() == 'admin');
    }

    // Binds payment to existing booking identity and outstanding balance
    function isValidPaymentForBooking(payment, database) {
      let booking = get(/databases/$(database)/documents/bookings/$(payment.bookingId)).data;
      return booking.ticketNumber == payment.ticketNumber &&
             booking.date == payment.drawDate &&
             booking.customerName == payment.customerName &&
             payment.amount <= booking.remainingBalance;
    }

    // =========================================================================
    // 0. SERVER-ONLY & PRIVATE COLLECTIONS
    // =========================================================================

    match /otpChallenges/{userId} {
      allow read, write: if false;
    }

    match /userDirectory/{username} {
      allow read, write: if false;
    }

    match /bookingIdempotency/{idempotencyKey} {
      allow read, write: if false;
    }

    // Customer identity and serial numbers: Admin only
    match /customerCodes/{codeDigits} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /customers/{customerKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Ticket Locks: Cashiers (Paid Employees) strictly blocked
    match /ticketLocks/{lockDocId} {
      allow read: if isOtpVerified() && !isPaidEmployeeRole();
      allow write: if false;
    }

    match /employeeLabels/{employeeUid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // =========================================================================
    // 1. SYSTEM & UI CONFIGURATION
    // =========================================================================
    match /config/{docId} {
      allow read: if isOtpVerified() && (
        docId == 'system' ||
        docId == 'appearance' ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // =========================================================================
    // 2. USER PROFILES
    // =========================================================================
    match /users/{userId} {
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // =========================================================================
    // 3. TICKET RESERVATIONS & INVENTORY
    // =========================================================================
    match /draws/{drawDate}/series/{seriesId}/tickets/{ticketNumber} {
      allow read: if isOtpVerified() && !isPaidEmployeeRole();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    match /ticketInventory/{inventoryId} {
      allow read: if isOtpVerified() && !isPaidEmployeeRole();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 4. BOOKINGS (Role-Based Isolation & Immutable Core Identity)
    // =========================================================================
    match /bookings/{bookingId} {
      allow read: if isOtpVerified() && (
        isAdmin() ||
        (isRegularEmployeeRole() && resource.data.bookedByUid == request.auth.uid)
      );
      allow create, delete: if false;
      allow update: if isAdmin() &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.ticketNumber == resource.data.ticketNumber &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.bookedByUid == resource.data.bookedByUid;
    }

    // =========================================================================
    // 5. PAYMENTS & CASHIER QUEUE
    // =========================================================================
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'bookingId', 'ticketNumber', 'drawDate', 'customerName',
          'amount', 'paymentMethod', 'paymentRef', 'paymentStatus',
          'confirmedBy', 'confirmedByUid', 'role', 'createdAt'
        ])
        && request.resource.data.bookingId is string
        && request.resource.data.ticketNumber is string
        && request.resource.data.drawDate is string
        && request.resource.data.customerName is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.paymentMethod is string
        && request.resource.data.paymentRef is string
        && request.resource.data.paymentStatus in ['Paid', 'Partial']
        && request.resource.data.confirmedBy is string
        && request.resource.data.confirmedByUid == request.auth.uid
        && request.resource.data.role == getUserRole()
        && exists(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId))
        && isValidPaymentForBooking(request.resource.data, database);
      allow update, delete: if false;
    }

    match /paymentQueue/{taskId} {
      allow read: if isOtpVerified() && (isAdmin() || isPaidEmployeeRole());
      allow write: if false;
    }

    // =========================================================================
    // 6. APPEND-ONLY AUDIT TRAIL
    // =========================================================================
    match /auditEvents/{eventId} {
      allow read: if false;
      allow create: if isEmployee()
        && request.resource.data.keys().hasOnly([
          'action', 'bookingBatchId', 'customerId', 'ticketCount',
          'drawDate', 'performedBy', 'performedByUid', 'role', 'timestamp'
        ])
        && request.resource.data.action == 'BOOKING_BATCH_CREATED'
        && request.resource.data.bookingBatchId is string
        && request.resource.data.customerId is string
        && request.resource.data.ticketCount is int
        && request.resource.data.ticketCount > 0
        && request.resource.data.drawDate is string
        && request.resource.data.performedBy is string
        && request.resource.data.performedByUid is string
        && request.resource.data.performedByUid == request.auth.uid
        && request.resource.data.role == getUserRole();
      allow update, delete: if false;
    }

    // =========================================================================
    // 7. WINNERS & RESULT PAPERS
    // =========================================================================
    match /winners/{winnerId} {
      allow read: if isOtpVerified();
      allow write: if isAdmin();
    }

    match /resultPapers/{paperId} {
      allow read: if isOtpVerified();
      allow write: if isAdmin();
    }
  }
}
